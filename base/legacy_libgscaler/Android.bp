
cc_library_shared {
    name: "libexynosgscaler",
    cflags: [
        "-Wno-unused-function",
    ],

    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libexynosscaler",
        "libexynosutils",
    ],

    header_libs: [
        "libcutils_headers",
        "libsystem_headers",
        "libhardware_headers",
        "libexynos_headers",
    ],

    local_include_dirs: ["include"],
 
    export_include_dirs: ["include"],

    srcs: [
        "libgscaler_obj.cpp",
        "libgscaler.cpp",
        "exynos_subdev.c",
    ] ,

    proprietary: true,
}
