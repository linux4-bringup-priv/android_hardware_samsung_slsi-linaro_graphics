cc_library_shared {
    name: "libexynosscaler",

    cflags: [
        "-DLOG_TAG=\"libexynosscaler\"",
    ] + select(soong_config_variable("libexynosscaler", "HAS_SCALER_ALIGN_RESTRICTION"), {
        "true": ["-DSCALER_ALIGN_RESTRICTION"],
        default: [],
    }) + select(soong_config_variable("libexynosscaler", "SCALER_USE_PREMUL_FMT"), {
        "true": ["-DSCALER_USE_PREMUL_FMT"],
        default: [],
    }) + select(soong_config_variable("libexynosscaler", "SCALER_USE_M2M1SHOT"), {
        "true": ["-DSCALER_USE_M2M1SHOT"],
        default: [],
    }),
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libacryl",
    ],

    header_libs: [
        "libcutils_headers",
        "libsystem_headers",
        "libhardware_headers",
        "libexynos_headers",
    ],

    local_include_dirs: select(soong_config_variable("libexynosscaler", "USE_LEGACY"), {
        "true": ["legacy/include"],
        default: ["include"],
    }),
 
    export_include_dirs: select(soong_config_variable("libexynosscaler", "USE_LEGACY"), {
        "true": ["legacy/include"],
        default: ["include"],
    }),

    srcs: select(soong_config_variable("libexynosscaler", "USE_LEGACY"), {
        "true": [
            "legacy/libscaler.cpp",
            "legacy/libscaler-v4l2.cpp",
            "legacy/libscalerblend-v4l2.cpp",
            "legacy/libscaler-m2m1shot.cpp",
            "legacy/libscaler-swscaler.cpp",
        ],
        default: ["libscaler.cpp"],
    }),

    proprietary: true,
}
