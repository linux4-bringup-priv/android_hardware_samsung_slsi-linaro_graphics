cc_library_shared {
    name: "libdrmresource",
    cflags: [
        "-DHLOG_CODE=0",
        "-Wno-unused-parameter",
        "-Wthread-safety",
    ],

    export_shared_lib_headers: ["libdrm"],

    shared_libs: [
        "libcutils",
        "libdrm",
        "liblog",
        "libutils",
        "libhardware",
    ],

    srcs: [
        "worker.cpp",
        "resourcemanager.cpp",
        "drmdevice.cpp",
        "drmconnector.cpp",
        "drmcrtc.cpp",
        "drmencoder.cpp",
        "drmmode.cpp",
        "drmplane.cpp",
        "drmproperty.cpp",
        "drmeventlistener.cpp",
        "vsyncworker.cpp",
    ],

    proprietary: true,
}
